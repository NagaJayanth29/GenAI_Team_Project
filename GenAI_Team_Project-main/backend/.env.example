# HostelIQ AI - Environment Configuration

# Gemini API Key (Official Google GenAI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY= #key


# Supabase PostgreSQL & Vector Database Configuration
# (Optional for live mode; if omitted, backend runs with high-fidelity local SQLite & vector cosine search)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
