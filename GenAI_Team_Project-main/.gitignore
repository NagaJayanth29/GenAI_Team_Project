# =============================================================================
# HostelIQ AI - Root .gitignore
# =============================================================================

# --- Environment files (sensitive: API keys, passwords, credentials) ---
# Ignore all local environment files at the project root
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Allow example template files (placeholders only - safe to commit)
!.env.example

# Backend environment files
backend/.env
!backend/.env.example

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/.env.*.local
!frontend/.env.example

# --- Node.js / Frontend ---
node_modules/
.npm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp
.pnp.*
.next/
out/
build/
dist/
.coverage
*.pem
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts
.vercel

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
env.bak/
venv.bak/
*.venv
.python-version
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
*.egg
.build
.dist

# --- Build outputs & cache ---
*.log
*.log.*
.cache/
.temp/
.tmp/
*.tmp
*.temp

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
